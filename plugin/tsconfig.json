{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2024", "dom", "dom.iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "types": [],
    // Types from the dev checkout; at runtime the bare specifiers resolve to
    // the vendored copies of the packaged app's own modules (see package.json).
    "paths": {
      "@deepseek-ai/cordis": ["../../deepseek-harness/vendor/cordis/lib/types/index.d.ts"],
      "@deepseek-ai/dsh-typert-protocol": ["../../deepseek-harness/packages/typert/protocol/lib/types/index.d.ts"]
    }
  },
  "include": ["src"]
}
